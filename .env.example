# Copy to ignored .env. Never commit credentials.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_MAX_BUDGET_USD=1.50

# Optional focused evidence workers. Claude still collects/reviews/synthesizes.
ARC_RESEARCH_WORKER_PROVIDER=anthropic
CRUSOE_API_KEY=
CRUSOE_WORKER_MODEL=nvidia/NVIDIA-Nemotron-3.5-Super-VL
CRUSOE_BASE_URL=https://api.inference.crusoecloud.com/v1
CRUSOE_MAX_OUTPUT_TOKENS=4096

# Source-provider credentials and application budgets are separate.
YDC_API_KEY=
FIRECRAWL_API_KEY=
GITHUB_TOKEN=
APIFY_API_TOKEN=
APIFY_MAX_TOTAL_CHARGE_USD=0.03
OSINT_MCP_URL=http://127.0.0.1:8001/mcp

NEO4J_URI=
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
ARC_FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional model overrides: CLAUDE_ORCHESTRATOR_MODEL, CLAUDE_HARVESTER_MODEL,
# CLAUDE_ARCHITECT_MODEL. Research adapter compatibility is checked at startup.
# Optional paths: ARC_DATABASE_PATH, ARC_PRIVATE_VAULT_PATH. Keep private and public stores separate.
